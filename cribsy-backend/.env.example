# Copy this file to .env and configure your local environment.

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

DATABASE_URL=sqlite:///cribsy.db

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Enable only during local development if verification codes
# need to be returned in API responses.
SHOW_DEV_CODES=false
