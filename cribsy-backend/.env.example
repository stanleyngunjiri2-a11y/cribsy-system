# Copy this file to .env and change the values. Never commit .env.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///rentconnect.db
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# true = verification codes and reset links are also returned in the API response (development only)
SHOW_DEV_CODES=true

# Cloudinary image storage (free account at cloudinary.com, then Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
